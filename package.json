{
  "name": "uniapp-vue3-template",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.22.0",
  "description": "uniapp vue3开发模版",
  "author": {
    "name": "yikoyu",
    "url": "https://github.com/yikoyu"
  },
  "license": "MIT",
  "homepage": "https://github.com/yikoyu",
  "repository": "https://github.com/yikoyu/uniapp-vue3-template",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "scripts": {
    "wx:dev": "uni -p mp-weixin",
    "wx:dev:tst": "uni -p mp-weixin --mode test",
    "wx:dev:prd": "uni -p mp-weixin --mode production",
    "wx:build:dev": "uni build -p mp-weixin --mode development",
    "wx:build:tst": "uni build -p mp-weixin --mode test",
    "wx:build:prd": "uni build -p mp-weixin --mode production",
    "ali:dev:tst": "uni -p mp-alipay --mode test",
    "ali:dev:prd": "uni -p mp-alipay --mode production",
    "ali:build:dev": "uni build -p mp-alipay --mode development",
    "ali:build:tst": "uni build -p mp-alipay --mode test",
    "ali:build:prd": "uni build -p mp-alipay --mode production",
    "h5:dev": "uni -p h5",
    "h5:dev:tst": "uni -p h5 --mode test",
    "h5:dev:prd": "uni -p h5 --mode production",
    "h5:build:dev": "uni build -p h5 --mode development",
    "h5:build:tst": "uni build -p h5 --mode test",
    "h5:build:prd": "uni build -p h5 --mode production",
    "alova-gen": "alova gen -f",
    "commit": "pnpm czg",
    "lint:js": "eslint .",
    "lint:css": "stylelint \"**/*.{css,scss,less,vue}\"",
    "lint": "eslint . && stylelint \"**/*.{css,scss,less,vue}\"",
    "lint:fix": "eslint . --fix && stylelint \"**/*.{css,scss,less,vue}\" --fix",
    "lint:vue": "vue-tsc --noEmit",
    "uvm": "pnpm dlx @dcloudio/uvm@latest",
    "preinstall": "npx -y only-allow pnpm",
    "prepare": "simple-git-hooks"
  },
  "dependencies": {
    "@alova/adapter-uniapp": "^2.0.17",
    "@alova/mock": "^2.0.21",
    "@dcloudio/uni-app": "3.0.0-5010520260709002",
    "@dcloudio/uni-app-harmony": "3.0.0-5010520260709002",
    "@dcloudio/uni-app-plus": "3.0.0-5010520260709002",
    "@dcloudio/uni-components": "3.0.0-5010520260709002",
    "@dcloudio/uni-h5": "3.0.0-5010520260709002",
    "@dcloudio/uni-mp-alipay": "3.0.0-5010520260709002",
    "@dcloudio/uni-mp-baidu": "3.0.0-5010520260709002",
    "@dcloudio/uni-mp-harmony": "3.0.0-5010520260709002",
    "@dcloudio/uni-mp-jd": "3.0.0-5010520260709002",
    "@dcloudio/uni-mp-kuaishou": "3.0.0-5010520260709002",
    "@dcloudio/uni-mp-lark": "3.0.0-5010520260709002",
    "@dcloudio/uni-mp-qq": "3.0.0-5010520260709002",
    "@dcloudio/uni-mp-toutiao": "3.0.0-5010520260709002",
    "@dcloudio/uni-mp-weixin": "3.0.0-5010520260709002",
    "@dcloudio/uni-mp-xhs": "3.0.0-5010520260709002",
    "@dcloudio/uni-quickapp-webview": "3.0.0-5010520260709002",
    "@uni-helper/uni-env": "^0.3.1",
    "@vueuse/core": "9.13.0",
    "@wot-ui/router": "^1.1.2",
    "@wot-ui/ui": "^2.2.0",
    "alova": "^3.5.3",
    "crypto-es": "^3.1.3",
    "dayjs": "^1.11.21",
    "echarts": "^6.1.0",
    "enum-plus": "^3.2.1",
    "es-toolkit": "^1.50.0",
    "pinia": "2.3.1",
    "pinia-plugin-persistedstate": "4.2.0",
    "qs": "^6.15.3",
    "uni-echarts": "^2.5.2",
    "vue": "3.4.21",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@alova/wormhole": "^1.5.2",
    "@antfu/eslint-config": "^9.2.0",
    "@dcloudio/types": "3.4.31",
    "@dcloudio/uni-automator": "3.0.0-5010520260709002",
    "@dcloudio/uni-cli-shared": "3.0.0-5010520260709002",
    "@dcloudio/uni-stacktracey": "3.0.0-5010520260709002",
    "@dcloudio/vite-plugin-uni": "3.0.0-5010520260709002",
    "@iconify-json/carbon": "^1.2.24",
    "@mini-types/alipay": "^3.0.14",
    "@types/qs": "^6.15.1",
    "@uni-helper/plugin-uni": "^0.1.0",
    "@uni-helper/uni-types": "^1.1.0",
    "@uni-helper/unocss-preset-uni": "^0.3.1",
    "@uni-helper/vite-plugin-uni-components": "^0.3.2",
    "@uni-helper/vite-plugin-uni-layouts": "^0.1.11",
    "@uni-helper/vite-plugin-uni-manifest": "^0.4.1",
    "@uni-helper/vite-plugin-uni-pages": "^0.4.7",
    "@uni-ku/bundle-optimizer": "^2.2.0",
    "@uni-ku/root": "^1.5.0",
    "@unocss/eslint-plugin": "^66.7.5",
    "@unocss/preset-legacy-compat": "^66.7.5",
    "@vue/runtime-core": "3.4.21",
    "@vue/tsconfig": "^0.9.1",
    "@yikoyu/commitlint-config": "^0.2.5",
    "@yikoyu/stylelint-config": "^0.2.0",
    "cz-git": "^1.13.1",
    "czg": "^1.13.1",
    "eslint": "^10.8.0",
    "lint-staged": "^17.2.0",
    "miniprogram-api-typings": "^5.2.2",
    "rollup-plugin-visualizer": "^7.0.1",
    "sass": "^1.102.0",
    "simple-git-hooks": "^2.13.1",
    "stylelint": "^17.14.1",
    "typescript": "~6.0.3",
    "unocss": "~66.7.5",
    "unocss-applet": "0.13.8",
    "unplugin-auto-import": "^21.0.0",
    "vite": "5.2.8",
    "vue-tsc": "^3.3.8"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged",
    "commit-msg": "pnpm commitlint --edit $1"
  },
  "lint-staged": {
    "**/*": [
      "eslint --fix"
    ],
    "**/*.{css,scss,less,vue}": [
      "stylelint --fix"
    ]
  }
}
